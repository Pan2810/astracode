{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Code ở đây được esbuild bundle (CJS cho extension host, IIFE cho webview),
    // nên TS chỉ cần kiểm kiểu — không cần biết định dạng module đầu ra.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vscode"],
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
