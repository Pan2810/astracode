# Sao chép thành .env — .env đã nằm trong .gitignore.

# ─── Gateway AstraWork — dùng cho MỌI thứ chạy ngoài VS Code ──────────────
# Địa chỉ gateway. KHÔNG kèm /v1: extension tự thêm khi cần.
ASTRAWORK_BASE_URL=http://localhost:8000

# JWT của chính bạn. Dùng cho script demo.
# Trong extension, token nằm ở SecretStorage chứ không phải file này.
#
# Lấy token: trong VS Code chạy lệnh "AstraCode: Sao chép token AstraWork".
# Nếu bạn đăng nhập bằng FPT SSO thì đây là thứ DUY NHẤT bạn cầm — bạn không
# có, và không cần, FPT API key.
ASTRAWORK_TOKEN=

# Đăng nhập bằng mật khẩu CHỈ dùng được cho tài khoản admin (xem auth.py của
# AstraWork). Member đăng nhập bằng Microsoft Entra ID.
ASTRAWORK_ADMIN_USER=
ASTRAWORK_ADMIN_PASSWORD=
